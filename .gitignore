# Captures, diagnostics and local map runs, not resources or test fixtures.
/earlogs/
/logs/
/diagnostics/
/pangea-flight-*/
/pangea-real-*/
/pangea-replay*/

# Local secrets, temporary files and process crash dumps.
.env
.env.*
!.env.example
!.env.sample
!.env.template
/pass.txt
*.tmp
/core
/core.[0-9]*
/tests
/tools
/tmp/

