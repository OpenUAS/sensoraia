<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<flight_plan alt="100" ground_alt="0" lat0="52.168595" lon0="4.412444" max_dist_from_home="1200" name="ValkenburgDemo" security_height="40">
  <header>
#include "modules/digital_cam/uart_cam_ctrl.h"
#include "modules/digital_cam/cam_point_nav.h"
static inline bool demo_accept_point(uint8_t reference, uint8_t target)
{
  if (!cam_point_within(USHER_CAMERA_LWIRCAM, reference, 300.f)) return false;
  return cam_point_to_waypoint(USHER_CAMERA_LWIRCAM, target);
}
  </header>
  <waypoints>
    <waypoint name="HOME" x="0" y="0"/>
    <waypoint name="SEARCH" x="0" y="300"/>
    <waypoint name="TARGET" x="0" y="300"/>
    <waypoint name="SOUTHWEST" x="-180" y="180"/>
    <waypoint name="NORTHEAST" x="180" y="420"/>
  </waypoints>
  <variables>
    <variable var="point_accepted" type="bool" init="FALSE"/>
    <variable var="survey_pass" type="uint8_t" init="0"/>
  </variables>
  <modules><module name="digital_cam_point"/></modules>
  <includes>
    <include procedure="sensoraia_fixedwing_flight.xml" name="flight"><with from="mission" to="Start demo"/></include>
  </includes>
  <blocks>
    <block name="Wait GPS">
      <set var="autopilot.kill_throttle" value="1"/>
      <while cond="!GpsFixValid()"/>
      <deroute block="flight.Holding point"/>
    </block>
    <block name="Start demo" strip_button="Find hotspot" strip_icon="survey.png">
      <set var="survey_pass" value="0"/>
      <set var="point_accepted" value="FALSE"/>
      <call_once fun="uart_cam_ctrl_set_camera_mask(USHER_CAMERA_MASK_LWIR)"/>
      <set var="dc_autoshoot_period" value="4"/>
      <deroute block="Session start"/>
    </block>
    <block name="Session start">
      <exception cond="NavBlockTime() @GT 5" deroute="flight.Standby"/>
      <exception cond="!digital_cam_uart_start(USHER_CAMERA_LWIRCAM)" deroute="Survey"/>
      <circle wp="SEARCH" radius="80"/>
    </block>
    <block name="Survey" on_exit="dc_autoshoot = DC_AUTOSHOOT_STOP">
      <set var="dc_autoshoot" value="DC_AUTOSHOOT_PERIODIC"/>
      <survey_rectangle wp1="SOUTHWEST" wp2="NORTHEAST" grid="60" orientation="NS" until="NavBlockTime() >= 40"/>
      <deroute block="Session stop"/>
    </block>
    <block name="Session stop">
      <exception cond="NavBlockTime() @GT 5" deroute="flight.Standby"/>
      <exception cond="!digital_cam_uart_stop(USHER_CAMERA_LWIRCAM)" deroute="Wait point"/>
      <circle wp="SEARCH" radius="80"/>
    </block>
    <block name="Wait point">
      <exception cond="cam_point_fresh(USHER_CAMERA_LWIRCAM)" deroute="Accept point"/>
      <exception cond="NavBlockTime() @GT 15" deroute="flight.Standby"/>
      <circle wp="SEARCH" radius="80"/>
    </block>
    <block name="Accept point">
      <call_once fun="point_accepted = demo_accept_point(WP_SEARCH, WP_TARGET)"/>
      <call_once fun="cam_point_consume(USHER_CAMERA_LWIRCAM)"/>
      <deroute block="Choose result"/>
    </block>
    <block name="Choose result">
      <exception cond="point_accepted" deroute="Orbit target"/>
      <set var="survey_pass" value="survey_pass+1"/>
      <deroute block="Retry"/>
    </block>
    <block name="Retry">
      <exception cond="survey_pass @GT 2" deroute="flight.Standby"/>
      <deroute block="Session start"/>
    </block>
    <block name="Orbit target">
      <circle wp="TARGET" radius="80" until="NavBlockTime() >= 60"/>
      <deroute block="flight.Land"/>
    </block>
  </blocks>
</flight_plan>