<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<flight_plan alt="100" ground_alt="0" lat0="52.168595" lon0="4.412444" max_dist_from_home="1200" name="ValkenburgDemo" security_height="40">
  <header>
#include "modules/digital_cam/uart_cam_ctrl.h"
  </header>
  <waypoints>
    <waypoint name="HOME" x="0" y="0"/>
    <waypoint name="SOUTHWEST" x="-180" y="180"/>
    <waypoint name="NORTHEAST" x="180" y="420"/>
  </waypoints>
  <variables>
    <variable var="camera_request" type="uint32_t" init="0"/>
    <variable var="zoom_applied" type="bool" init="FALSE"/>
    <variable var="retract_applied" type="bool" init="FALSE"/>
  </variables>
  <includes>
    <include procedure="sensoraia_fixedwing_flight.xml" name="flight"><with from="mission" to="Start demo"/></include>
  </includes>
  <blocks>
    <block name="Wait GPS">
      <set var="autopilot.kill_throttle" value="1"/>
      <while cond="!GpsFixValid()"/>
      <deroute block="flight.Holding point"/>
    </block>
    <block name="Start demo" strip_button="CHDK survey" strip_icon="survey.png">
      <set var="dc_autoshoot" value="DC_AUTOSHOOT_STOP"/>
      <call_once fun="uart_cam_ctrl_set_camera_mask(USHER_CAMERA_MASK_CHDK)"/>
      <deroute block="Zoom in"/>
    </block>
    <block name="Zoom in">
      <call_once fun="camera_request = uart_cam_ctrl_zoom(USHER_CAMERA_MASK_CHDK, 128)"/>
      <circle wp="STDBY" radius="80" until="!uart_cam_ctrl_command_pending(camera_request)"/>
      <call_once fun="zoom_applied = uart_cam_ctrl_command_result(camera_request) == CAM_CONTROL_APPLIED"/>
      <deroute block="Survey"/>
    </block>
    <block name="Survey" on_exit="dc_autoshoot = DC_AUTOSHOOT_STOP">
      <call_once fun="dc_distance(80.f)"/>
      <survey_rectangle wp1="SOUTHWEST" wp2="NORTHEAST" grid="60" orientation="NS" until="NavBlockTime() >= 120"/>
      <deroute block="Landing cleanup"/>
    </block>
    <block name="Landing cleanup" strip_button="Retract and land" strip_icon="land-right.png">
      <set var="dc_autoshoot" value="DC_AUTOSHOOT_STOP"/>
      <call_once fun="camera_request = uart_cam_ctrl_retract(USHER_CAMERA_MASK_CHDK)"/>
      <circle wp="STDBY" radius="80" until="!uart_cam_ctrl_command_pending(camera_request)"/>
      <call_once fun="retract_applied = uart_cam_ctrl_command_result(camera_request) == CAM_CONTROL_APPLIED"/>
      <deroute block="flight.Land"/>
    </block>
  </blocks>
</flight_plan>