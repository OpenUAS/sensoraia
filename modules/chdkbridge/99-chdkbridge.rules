ACTION=="remove", GOTO="chdkbridge_end"
SUBSYSTEM!="usb", GOTO="chdkbridge_end"
ENV{DEVTYPE}!="usb_device", GOTO="chdkbridge_end"
ATTR{idVendor}!="04a9", GOTO="chdkbridge_end"
ENV{ID_USB_INTERFACES}=="", IMPORT{builtin}="usb_id"
ENV{ID_USB_INTERFACES}=="*:060101:*", GROUP="plugdev", MODE="0660"
LABEL="chdkbridge_end"
