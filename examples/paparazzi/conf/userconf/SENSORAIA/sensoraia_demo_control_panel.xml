      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="Messages"/>
      <program name="Messages (Legacy)"/>
    </session>
    <session name="Sensoraia MORA desk NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
