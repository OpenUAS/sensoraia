<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">

<!-- Generic specialized-camera demo: run one camera session with start/stop, then
     move a waypoint onto the point that camera deduced. Nothing here is specific to
     a camera type; USHER_CAMERA_EARCAM selects the acoustic camera, and any other
     camera that reports a point works with the same calls.
     Requires modules digital_cam_uart + digital_cam_point, USHER on MORA with the
     matching backend enabled, and the pose stream that feeds the camera session. -->
<flight_plan alt="200" ground_alt="140" lat0="48.808252" lon0="7.856789" max_dist_from_home="800" name="CAM_POINT_DEMO" security_height="50" home_mode_height="70">
  <header>
#include "modules/datalink/datalink.h"
#include "modules/digital_cam/dc.h"
#include "modules/digital_cam/uart_cam_ctrl.h"
#include "modules/digital_cam/cam_point_nav.h"

#define DEMO_CAMERA USHER_CAMERA_EARCAM
  </header>

  <waypoints>
    <waypoint name="HOME" x="0" y="0" height="2."/>
    <waypoint name="STDBY" x="20." y="80." height="70."/>
    <waypoint name="CLIMB" x="53." y="146." height="70."/>
    <waypoint name="AF" x="-21." y="66." alt="215."/>
    <waypoint name="TD" x="-127." y="0." alt="185."/>
    <waypoint name="_BASELEG" x="56." y="367."/>
    <!-- Centre of the area the camera listens over. -->
    <waypoint name="SEARCH" lat="48.81045" lon="7.85170" height="60."/>
    <!-- Moved by the flight plan onto whatever point the camera reports. -->
    <waypoint name="TARGET" lat="48.81045" lon="7.85170" height="60."/>
  </waypoints>

  <variables>
    <variable var="cam_retry" type="uint8_t" init="0"/>
  </variables>

  <modules>
    <module name="digital_cam_point"/>
  </modules>

  <blocks>
    <block name="Wait GPS">
      <set value="1" var="autopilot.kill_throttle"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 10)"/>
      <call_once fun="NavSetGroundReferenceHere()"/>
    </block>
    <block name="Holding point">
      <set value="1" var="autopilot.kill_throttle"/>
      <attitude roll="0" throttle="0" vmode="throttle"/>
    </block>
    <block name="Takeoff" strip_icon="takeoff.png" strip_button="Takeoff (wp CLIMB)">
      <set var="autopilot.kill_throttle" value="0"/>
      <set var="autopilot.flight_time" value="0"/>
      <set var="autopilot.launch" value="1"/>
      <exception cond="GetPosAlt() @GT GetAltRef()+25" deroute="Standby"/>
      <go wp="CLIMB"/>
    </block>
    <block name="Standby" strip_button="Standby" strip_icon="home.png">
      <circle radius="nav_radius" wp="STDBY"/>
    </block>

    <!-- 1. Open the camera session and fly over the area while it accumulates. -->
    <block name="cam_search" strip_button="Find point" strip_icon="survey.png">
      <set var="cam_retry" value="0"/>
      <deroute block="cam_search_start"/>
    </block>
    <block name="cam_search_start">
      <exception cond="NavBlockTime() @GT 3" deroute="cam_search_failed"/>
      <exception cond="!digital_cam_uart_start(DEMO_CAMERA)" deroute="cam_search_run"/>
      <circle radius="nav_radius" wp="STDBY"/>
    </block>
    <block name="cam_search_run">
      <exception cond="NavBlockTime() @GT 60" deroute="cam_search_stop"/>
      <circle radius="nav_radius" wp="SEARCH"/>
    </block>

    <!-- 2. Close the session. The camera answers asynchronously, so the block that
         commands the stop must not test the reply itself: command here, wait next. -->
    <block name="cam_search_stop">
      <exception cond="NavBlockTime() @GT 3" deroute="cam_search_failed"/>
      <exception cond="!digital_cam_uart_stop(DEMO_CAMERA)" deroute="cam_search_wait"/>
      <circle radius="nav_radius" wp="STDBY"/>
    </block>
    <block name="cam_search_wait">
      <exception cond="cam_point_fresh(DEMO_CAMERA)" deroute="cam_search_apply"/>
      <exception cond="NavBlockTime() @GT 10" deroute="cam_search_failed"/>
      <circle radius="nav_radius" wp="STDBY"/>
    </block>

    <!-- 3. Apply the reported point. A reply without a usable estimate, a point
         outside the search area, or one outside the navigation limits is refused. -->
    <block name="cam_search_apply">
      <exception cond="!cam_point_within(DEMO_CAMERA, WP_SEARCH, 300.)" deroute="cam_search_failed"/>
      <exception cond="!cam_point_to_waypoint(DEMO_CAMERA, WP_TARGET)" deroute="cam_search_failed"/>
      <call_once fun="cam_point_consume(DEMO_CAMERA)"/>
      <deroute block="cam_goto_target"/>
    </block>
    <block name="cam_goto_target" strip_button="Go to point">
      <circle radius="nav_radius" wp="TARGET"/>
    </block>
    <block name="cam_search_failed">
      <!-- No usable answer: retry the session once, then hold. -->
      <call_once fun="cam_point_consume(DEMO_CAMERA)"/>
      <set var="cam_retry" value="cam_retry + 1"/>
      <exception cond="cam_retry @GT 1" deroute="Standby"/>
      <exception cond="NavBlockTime() @GT 3" deroute="cam_search_start"/>
      <circle radius="nav_radius" wp="STDBY"/>
    </block>

    <block name="Land Right AF-TD" strip_button="Land right (wp AF-TD)" strip_icon="land-right.png">
      <set var="nav_radius" value="DEFAULT_CIRCLE_RADIUS"/>
      <deroute block="land"/>
    </block>
    <block name="Land Left AF-TD" strip_button="Land left (wp AF-TD)" strip_icon="land-left.png">
      <set var="nav_radius" value="-DEFAULT_CIRCLE_RADIUS"/>
      <deroute block="land"/>
    </block>
    <block name="land">
      <call_once fun="nav_compute_baseleg(WP_AF, WP_TD, WP__BASELEG, nav_radius)"/>
      <circle radius="nav_radius" until="NavCircleCount() @GT 0.5" wp="_BASELEG"/>
      <circle radius="nav_radius" until="NavQdrCloseTo(DegOfRad(baseleg_out_qdr)-(nav_radius/fabs(nav_radius))*10) @AND 10 @GT fabs(GetPosAlt() - WaypointAlt(WP__BASELEG))" wp="_BASELEG"/>
    </block>
    <block name="final">
      <exception cond="GetAltRef() + 10 @GT GetPosAlt()" deroute="flare"/>
      <go from="AF" hmode="route" vmode="glide" wp="TD"/>
    </block>
    <block name="flare">
      <go approaching_time="0" from="AF" hmode="route" throttle="0.0" vmode="throttle" wp="TD"/>
      <attitude roll="0.0" throttle="0.0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>
