digraph USHER {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.4",
    nodesep="0.38",
    ranksep="0.55",
    fontname="DejaVu Sans Bold",
    label="USHER  |  From flight event to analyzed image",
    labelloc="t",
    labeljust="c",
    fontsize=26,
    fontcolor="#111111",
    splines=ortho
  ];

  node [
    shape=rect,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=15,
    fontcolor="#111111",
    color="#111111",
    penwidth=2.2,
    margin="0.25,0.16"
  ];

  edge [
    fontname="DejaVu Sans Bold",
    fontsize=13,
    fontcolor="#111111",
    color="#111111",
    penwidth=2.4,
    arrowsize=1.0
  ];

  shot [
    label="1  PAPARAZZI SHOT\nindex + GPS + altitude\nroll + pitch + yaw + speed + course",
    fillcolor="#fef9c3",
    color="#ca8a04",
    fontname="DejaVu Sans Bold"
  ];

  transport [
    label="2  USHER TRANSPORT\nreal serial device (/dev/serial0) or local PTY bridge",
    fillcolor="#f1f5f9",
    color="#475569"
  ];

  dispatcher [
    label="3  USHER MEDIATOR\nlive optical: active + newest waiting request\nindependent single-flight LWIR worker\ngeneric session hooks; EAR owns its finalizer",
    fillcolor="#ffedd5",
    color="#ea580c",
    penwidth=2.8,
    fontname="DejaVu Sans Bold"
  ];

  subgraph cluster_capture {
    label="4  OBTAIN ONE JPEG";
    labelloc="t";
    fontsize=17;
    fontname="DejaVu Sans Bold";
    fontcolor="#111111";
    color="#ca8a04";
    fillcolor="#fefce8";
    style="rounded,filled";
    margin=20;

    local [
      label="LOCAL / TEST\nselect testphotos/*.jpg\nor --mock-image\ncopy to ../Pictures/m%06d.jpg",
      fillcolor="#dcfce7",
      color="#16a34a",
      penwidth=2.2
    ];

    mock_map [
      label="MIMIC / --mock-map\nlocal zoom-18 XYZ cache\npprzgcs legacy path: GOOGLE/18\nup to 3x3 tiles + shot pose + FOV\n../Pictures/m{c,a,l}%06d.jpg\nvisible texture only; no thermal processing",
      fillcolor="#dcfce7",
      color="#16a34a",
      penwidth=2.2
    ];

    chdk [
      label="CHDK\ncamera capture + download\nmove to photos/c%06d.jpg",
      fillcolor="#fef08a",
      color="#ca8a04",
      penwidth=2.2
    ];

    aicam [
      label="AI CAMERA\npersistent rpicam-still, two-buffer ZSL\nmetadata: ordinary signal mode\nfallback + retry cooldown\nphotos/a%06d.jpg",
      fillcolor="#fed7aa",
      color="#ea580c",
      penwidth=2.2
    ];

    lwircam [
      label="LWIR CAMERA\nTiny 1-C lwircam --capture-server\nreject startup frames\nphotos/l%06d.jpg with embedded temperature plane",
      fillcolor="#e0f2fe",
      color="#0284c7",
      penwidth=2.2
    ];

    {rank=same; local; mock_map; chdk; aicam; lwircam;}
  }

  transform [
    label="5  OPTIONAL TEST TRANSFORM\n--mocktransform\nroll + pitch + yaw perspective\nauto FOV + borderless cover crop\nnear horizon: synth terrain or black\nvendored IJG libjpeg\nblur factor logged, not applied",
    fillcolor="#f3e8ff",
    color="#9333ea",
    penwidth=2.2
  ];

  exif [
    label="6  EXIF METADATA\nbounded observation-time pose when available\noriginal request + timing + uncertainty retained\narrival-only estimates labelled separately\nLWIR: hotspot GPS + center temperature\ncalibration required for coordinates",
    fillcolor="#fce7f3",
    color="#db2777",
    penwidth=2.2,
    fontname="DejaVu Sans Bold"
  ];

  mock_hotspots [
    label="LWIR TEST ONLY\nlwircam --mock-image\nembedded temperature plane\nsource EXIF/XMP retained",
    fillcolor="#e0f2fe",
    color="#0284c7",
    penwidth=2.2
  ];

  final [
    label="7  FINAL JPEG\natomic replacement complete\nnever expose a partial rewrite",
    fillcolor="#fef08a",
    color="#111111",
    penwidth=3.0,
    fontname="DejaVu Sans Bold"
  ];

  soda [
    label="8  SODA HAND-OFF\n--aicam / --chdkcam / --lwircam / --earcam\nlive: one background worker; fresh jobs first\nno capture worker waits for analysis\nlocal AIcam --lens-profile: native C++ camera_lens\nretain clean JPEG; analyse derivative only on success\nhotspot EXIF retained on MORA\nno hotspot return message yet",
    fillcolor="#fee2e2",
    color="#dc2626",
    penwidth=2.2
  ];

  pangea [
    label="OPTIONAL PANGEA / --pangea DIR\nreal originals + camera profile / clean MIMIC\nindependent idle C++ directory watcher\nbounded disk tiles -> georeferenced map\nno capture or SODA wait; no added effects",
    fillcolor="#dcfce7",
    color="#16a34a"
  ];
  soda_backlog [
    label="DEFERRED SODA\n1024 filename + original pose jobs; no pixels\nolder jobs: 2 s without triggers and capture idle\nnew photos first; one retry on failure\nsession-only queue; originals retained",
    fillcolor="#e0f2fe",
    color="#0284c7"
  ];
  soda -> soda_backlog [xlabel="busy", color="#0284c7"];
  soda_backlog -> soda [xlabel="idle catch-up", color="#0284c7"];
  final -> pangea [style=dashed, color="#16a34a"];

  shot -> transport;
  transport -> dispatcher;
  dispatcher -> local [color="#16a34a"];
  dispatcher -> mock_map [color="#16a34a"];
  mock_map -> exif [color="#16a34a"];
  dispatcher -> chdk [color="#ca8a04"];
  dispatcher -> aicam [color="#ea580c"];
  dispatcher -> lwircam [color="#0284c7"];
  local -> transform [color="#16a34a"];
  chdk -> transform [color="#ca8a04"];
  aicam -> transform [color="#ea580c"];
  lwircam -> transform [color="#0284c7"];
  transform -> mock_hotspots [color="#9333ea"];
  mock_hotspots -> exif [color="#0284c7"];
  exif -> final [color="#db2777"];
  final -> soda [color="#111111"];
  lens [label="OPTIONAL LOCAL AICAM LENS STAGE\n--mock-lens PROFILE.json with --mock-map\nSODA: OpenCV lens + exposure + shutter\nclean JPEG retained; .lens.jpg analysed\nfailure skips analysis", fillcolor="#e6f3ef", color="#16745a"];
  soda -> lens [color="#16745a"];
}
