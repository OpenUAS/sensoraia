<control_panel name="Sensoraia">
  <section name="programs">
    <program name="Simulator" command="sw/simulator/pprzsim-launch" icon="simulator.png">
      <arg flag="-a" constant="@AIRCRAFT"/>
    </program>
    <program name="USHER" command="sw/ext/sensoraia/usher"/>
    <program name="Data Link" command="sw/ground_segment/tmtc/link"/>
    <program name="Server" command="sw/ground_segment/tmtc/server"/>
    <program name="PprzGCS" command="sw/ground_segment/cockpit/pprzgcs" icon="gcs.svg" favorite="true"/>
    <program name="GCS Classic" command="sw/ground_segment/cockpit/pprzgcs" icon="gcs.svg"/>
    <program name="Flight Plan Editor" command="sw/ground_segment/cockpit/pprzgcs" icon="gcs.svg">
      <arg flag="-f"/>
    </program>
    <program name="Environment Simulator" command="sw/simulator/gaia.py"/>
    <program name="UnifiedMoCap" command="sw/ext/unifiedmocaprouter/build/mocap-router" icon="natnet.svg">
      <arg flag="optitrack"/>
      <arg flag="ivy"/>
      <arg flag="--publish_frequency" constant="10"/>
      <arg flag="--coordinate_system" constant="enu"/>
      <arg flag="--coordinate_north" constant="far"/>
      <arg flag="--craft_noses" constant="right"/>
      <arg flag="--streaming_ids" constant="1"/>
      <arg flag="--ac_id" constant="@AC_ID"/>
    </program>
    <program name="Joystick" command="sw/ground_segment/joystick/input2ivy" icon="joystick.svg">
      <arg flag="-ac" constant="@AIRCRAFT"/>
      <arg flag="xbox_gamepad.xml"/>
    </program>
    <program name="Messages" command="sw/ground_segment/messages-gui/messages.py"/>
    <program name="Messages (Legacy)" command="sw/ground_segment/tmtc/messages"/>
    <program name="Real-time Plotter" command="sw/logalizer/plotter" icon="plotter.svg"/>
  </section>
  <section name="sessions">
    <session name="Sensoraia Spottercam NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--test"/>
        <arg flag="--mock-image" constant="resources/mock_aicam_01.jpg"/>
        <arg flag="--spottercam"/>
        <arg flag="--spottercam-settings" constant="modules/spotter_cam/spottercam_settings.ini"/>
        <arg flag="--spottercam-targets" constant="examples/pangea/aicam-2028.ini"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia AIcam NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--test"/>
        <arg flag="--mocktransform"/>
        <arg flag="--aicam"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia LWIRcam NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--test"/>
        <arg flag="--lwircam"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia CHDKcam NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--test"/>
        <arg flag="--chdk"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia EARcam NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--test"/>
        <arg flag="--earcam-sim" constant="52.171291,4.412444,100"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia LOOMcam NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--test"/>
        <arg flag="--mock-map"/>
        <arg flag="--mock-lens" constant="resources/camera_lens_aicam.json"/>
        <arg flag="--loomcam"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia MIMIC PANGEA NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
        <arg flag="-n"/>
      </program>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--mock-map"/>
        <arg flag="--pangea" constant="~/Pictures/sensoraia/pangea-mimic"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia Diplacam NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
        <arg flag="--norc"/>
      </program>
      <program name="Data Link">
        <arg flag="-udp"/>
        <arg flag="-udp_broadcast"/>
      </program>
      <program name="Server">
