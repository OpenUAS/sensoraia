      <program name="USHER">
        <arg flag="--local"/>
        <arg flag="--diplacam-config" constant="modules/dipla_cam/diplacam-nps.ini"/>
        <arg flag="--debug"/>
      </program>
    </session>
    <session name="Sensoraia Diplacam MORA Real Cyberzoo Flight">
      <program name="Data Link">
        <arg flag="-udp"/>
      </program>
      <program name="UnifiedMoCap">
        <arg flag="optitrack"/>
        <arg flag="ivy"/>
        <arg flag="--publish_frequency" constant="10"/>
        <arg flag="--coordinate_system" constant="enu"/>
        <arg flag="--coordinate_north" constant="far"/>
        <arg flag="--craft_noses" constant="right"/>
        <arg flag="--streaming_ids" constant="1"/>
        <arg flag="--ac_id" constant="160"/>
      </program>
      <program name="Joystick">
        <arg flag="-ac" constant="Bebop_DIPLACAM"/>
        <arg flag="sm600.xml"/>
        <arg flag="-d" constant="0"/>
      </program>
      <program name="Server"/>
      <program name="PprzGCS">
        <arg flag="--maximize"/>
      </program>
      <program name="Messages (Legacy)"/>
      <program name="Real-time Plotter"/>
    </session>
    <session name="Sensoraia Diplacam MORA desk NPS">
      <program name="Simulator">
        <arg flag="-a" constant="@AIRCRAFT"/>
        <arg flag="-t" constant="nps"/>
